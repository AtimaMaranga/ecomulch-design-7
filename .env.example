# ─── EcoMulch admin ───────────────────────────────────────────────
# The password the client types to sign in at /admin.
ADMIN_PASSWORD=change-me-to-a-strong-password

# A long random string used to sign the login session cookie.
# Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ─── Supabase (the live, database-backed mode) ────────────────────
# Leave these BLANK during local development to use the local-file store.
# Fill them in (locally in .env.local, and in your Vercel project settings)
# to store content in Supabase so edits persist and go live in production.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
